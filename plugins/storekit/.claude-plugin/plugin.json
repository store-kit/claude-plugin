{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "storekit",
  "displayName": "storekit",
  "version": "1.1.0",
  "description": "Ask Claude about sales, takings, orders, refunds, menus, guests and reviews across your storekit stores, and make approved changes like snoozes, discount codes and payment links. Includes a storekit manager skill and four ready-made commands.",
  "author": {
    "name": "StoreKit",
    "email": "mcp@storekit.com",
    "url": "https://storekit.com"
  },
  "homepage": "https://github.com/store-kit/claude-plugin#readme",
  "repository": "https://github.com/store-kit/claude-plugin",
  "license": "MIT",
  "keywords": [
    "storekit",
    "hospitality",
    "restaurants",
    "orders",
    "payments",
    "mcp",
    "oauth"
  ],
  "defaultEnabled": true,
  "metadata": {
    "icon": "https://raw.githubusercontent.com/store-kit/claude-plugin/main/assets/icon.png",
    "logo": "https://ucarecdn.com/20d662e7-f923-4257-abce-3cb8e7db1d7e/-/format/auto/",
    "mcpServerUrl": "https://mcp.storekit.com/mcp",
    "auth": "oauth2.1"
  },
  "mcpServers": "./.mcp.json",
  "skills": "./skills/",
  "commands": "./commands/",
  "privacyPolicyUrl": "https://storekit.com/privacy-policy"
}
